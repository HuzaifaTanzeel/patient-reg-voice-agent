# Local Postgres (docker compose). Production sets this on the host, not here.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patient_reg
# Retell API key (Dashboard -> Settings -> API Keys). Required for webhook
# signature verification and for scripts that call the Retell API.
RETELL_API_KEY=
# Set to false to accept unsigned Retell webhook posts (e.g. local testing).
VERIFY_RETELL_SIGNATURE=true
